{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Provisional typed cross-venue market-pair annotations",
  "type": "array",
  "minItems": 32,
  "maxItems": 32,
  "items": {
    "type": "object",
    "required": [
      "pair_id",
      "A",
      "B",
      "external_reference",
      "relation_candidate",
      "candidate_status",
      "forbidden_states",
      "forbidden_states_scope",
      "state_assessment",
      "established_contract_forbidden_states",
      "reasoning",
      "scope",
      "missing_evidence",
      "evidence_source_ids",
      "provenance",
      "human_gold"
    ],
    "properties": {
      "pair_id": {
        "type": "string",
        "pattern": "^rel_[0-9]{2}$"
      },
      "A": {
        "$ref": "#/$defs/market"
      },
      "B": {
        "$ref": "#/$defs/market"
      },
      "relation_candidate": {
        "enum": [
          "EQUIVALENT",
          "A_IMPLIES_B",
          "B_IMPLIES_A",
          "DISJOINT",
          "COMPLEMENT",
          "NO_HARD_RELATION",
          "ABSTAIN",
          "OUT_OF_BINARY_SCOPE"
        ]
      },
      "forbidden_states": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "00",
                "01",
                "10",
                "11"
              ]
            }
          }
        ]
      },
      "state_assessment": {
        "type": "object",
        "required": [
          "00",
          "01",
          "10",
          "11"
        ],
        "additionalProperties": {
          "enum": [
            "unknown_or_out_of_binary_scope",
            "forbidden_under_assumptions",
            "not_excluded_under_assumptions"
          ]
        }
      },
      "established_contract_forbidden_states": {
        "type": "null"
      },
      "reasoning": {
        "type": "string",
        "minLength": 1
      },
      "scope": {
        "type": "object",
        "required": [
          "level",
          "payoff_scope",
          "assumptions"
        ],
        "properties": {
          "assumptions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      },
      "missing_evidence": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string"
        }
      },
      "evidence_source_ids": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "human_gold": {
        "const": false
      }
    }
  },
  "$defs": {
    "market": {
      "type": "object",
      "required": [
        "venue",
        "external_id",
        "derived_yes_description",
        "source_pointers"
      ],
      "properties": {
        "venue": {
          "enum": [
            "Polymarket",
            "Kalshi"
          ]
        },
        "external_id": {
          "type": "string",
          "minLength": 1
        },
        "derived_yes_description": {
          "type": "string",
          "minLength": 1
        },
        "source_pointers": {
          "type": "array",
          "minItems": 1
        }
      }
    }
  }
}
